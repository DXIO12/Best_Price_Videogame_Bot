# =========================================
# Build artifacts (PyInstaller)
# =========================================
# `build/` here is PyInstaller's own `--workpath` default, created at the repo
# root during a build and safe to delete. The *scripts* that drive the build
# live in `packaging/` and are tracked — they used to sit in `build/`, where
# this very line silently hid every new file added to them.
dist/
build/
*.spec

# Chromium kept between builds so a rebuild is a copy, not a 370 MB download.
.browser-cache/
