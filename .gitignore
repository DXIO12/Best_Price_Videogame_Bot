# =========================================
# Backups
# =========================================

# `*.db` above only matches names that *end* in .db, so a copy named
# tracker.db.bak-20260822-111558 slipped through and showed up as untracked.
# Both shapes a backup usually takes are covered here.
*.bak*
*.db.*

# Which database file is in use. Deliberately NOT config.json: that file is
# tracked, so a branch switch reverted the pointer, the app opened a database
# that was not there, and SQLite created an empty one in its place.
application/database/active_db.txt

